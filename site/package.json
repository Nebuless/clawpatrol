{
  "name": "nebprx-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vpx scripts/gen-examples.mjs && vp dev",
    "build": "vpx scripts/gen-examples.mjs && tsc --noEmit && vp build && vpx build-docs.ts && bash scripts/build-demo.sh",
    "build:demo": "bash scripts/build-demo.sh",
    "deploy": "pnpm run build && vp exec wrangler deploy",
    "test": "vp test",
    "check": "vp check",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "telemetry": "vpx scripts/telemetry.ts"
  },
  "dependencies": {
    "@observablehq/plot": "0.6.17",
    "highlight.js": "11.11.1",
    "marked": "18.0.3",
    "marked-highlight": "2.2.4",
    "preact": "10.29.2",
    "preact-render-to-string": "6.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261030.1",
    "@preact/preset-vite": "2.10.5",
    "@tailwindcss/vite": "4.3.0",
    "@types/node": "22.19.19",
    "tailwindcss": "4.3.0",
    "typescript": "5.9.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "4.156.0"
  },
  "packageManager": "pnpm@12.16.1"
}
