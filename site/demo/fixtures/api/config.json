"info_listen = \"100.99.99.10:8080\"\npublic_url  = \"http://100.99.99.10:8080\"\nadmin_email = \"demo@example.com\"\nstate_dir   = \"./state\"\n\ncontrol        = \"wireguard\"\nwg_subnet_cidr = \"100.99.0.0/24\"\nlisten         = \"100.99.99.10:8443\"\n\nendpoint \"https\" \"anthropic\" { hosts = [\"api.anthropic.com\"] }\nendpoint \"https\" \"chatgpt\"   { hosts = [\"chatgpt.com\"] }\nendpoint \"https\" \"github\"    { hosts = [\"api.github.com\", \"github.com\", \"raw.githubusercontent.com\"] }\nendpoint \"https\" \"notion\"    { hosts = [\"api.notion.com\"] }\n\nendpoint \"kubernetes\" \"k8s-prod-eu\" { server = \"https://k8s-prod-eu.example.com\" }\nendpoint \"kubernetes\" \"k8s-prod-us\" { server = \"https://k8s-prod-us.example.com\" }\n\nendpoint \"postgres\"         \"postgres-prod\"   { host  = \"deploy-prod-rds.example.com:5432\" }\nendpoint \"clickhouse_https\" \"clickhouse-prod\" { hosts = [\"clickhouse-prod.example.com:8443\"] }\n\ncredential \"anthropic_manual_key\" \"anthropic-key\" {}\n\ncredential \"anthropic_oauth_subscription\" \"anthropic-engineering-bot\"   { endpoint = https.anthropic }\ncredential \"anthropic_oauth_subscription\" \"anthropic-macbook\"   { endpoint = https.anthropic }\ncredential \"openai_codex_oauth\"           \"codex-engineering-bot\"       { endpoint = https.chatgpt }\ncredential \"github_oauth\"                 \"github-engineering-bot\"      { endpoint = https.github }\ncredential \"github_oauth\"                 \"github-pagerdutybot\" { endpoint = https.github }\ncredential \"notion_oauth\"                 \"notion-pagerdutybot\" { endpoint = https.notion }\ncredential \"mtls_credential\"              \"k8s-prod-eu-mtls\"    { endpoint = kubernetes.k8s-prod-eu }\ncredential \"mtls_credential\"              \"k8s-prod-us-mtls\"    { endpoint = kubernetes.k8s-prod-us }\ncredential \"postgres_credential\" \"postgres-cred\" {\n  endpoint = postgres.postgres-prod\n  user     = \"pagerdutybot\"\n}\ncredential \"clickhouse_credential\" \"clickhouse-cred\" {\n  endpoint = clickhouse_https.clickhouse-prod\n  user     = \"pagerdutybot\"\n}\n\napprover \"human_approver\" \"dashboard-ops\" {\n  channel = \"#member-portal-approvals\"\n}\n\npolicy \"k8s-exec-content\" {\n  text = <<-EOT\n    Inspect the kubectl exec command (each ?command= argv element).\n    Deny if it dumps env vars (env, printenv, set, export, cat\n    /proc/*/environ). Deny if it reads sensitive host-mount files\n    (kubelet pod tokens, certs, private keys, kubeconfig,\n    /etc/shadow, containerd/CRI sockets). Allow ls, ps, df, ip, ss,\n    mount, dmesg, top for debugging.\n  EOT\n}\n\npolicy \"pg-prod-secret-columns\" {\n  text = <<-EOT\n    The query runs against the deploy-prod RDS database. Deny if\n    the SELECT projects (directly, via *, via aggregates like\n    json_agg / encode, or via a JSONB extract that returns secret\n    keys) any of:\n\n      - github_identities.access_token / .refresh_token\n      - tokens.hash\n      - custom_domain_tls_certificates.private_key\n      - oauth_states.csrf_token / .pkce_code_verifier\n      - organization_invites.one_time_token\n      - projects.env_vars / deployments.env_vars (jsonb \u2014 contains\n        operator-set secrets)\n      - users.email or users.meta when the projection isn't a narrow\n        admin lookup (count(*) is fine; SELECT email without a tight\n        WHERE is not).\n\n    Allow reads of every other column. A secret-named identifier\n    appearing only in a string literal or non-projected predicate\n    (e.g. WHERE access_token IS NOT NULL) is fine.\n  EOT\n}\n\napprover \"llm_approver\" \"k8s-exec-content-judge\" {\n  model      = \"claude-haiku-4-5-20251001\"\n  credential = anthropic_manual_key.anthropic-key\n  policy     = policy.k8s-exec-content\n}\napprover \"llm_approver\" \"pg-prod-secret-columns-judge\" {\n  model      = \"claude-haiku-4-5-20251001\"\n  credential = anthropic_manual_key.anthropic-key\n  policy     = policy.pg-prod-secret-columns\n}\n\nrule \"anthropic-allow\" {\n  endpoint  = https.anthropic\n  condition = \"true\"\n  verdict   = \"allow\"\n}\n\nrule \"codex-allow\" {\n  endpoint  = https.chatgpt\n  condition = \"true\"\n  verdict   = \"allow\"\n}\n\nrule \"github-reads\" {\n  endpoint  = https.github\n  condition = \"http.method in ['GET', 'HEAD', 'OPTIONS']\"\n  verdict   = \"allow\"\n}\n\nrule \"github-no-delete-repo\" {\n  endpoint = https.github\n  priority = 1000\n  condition = <<-CEL\n    http.method == 'DELETE'\n    && http.path.matches('^/repos/[^/]+/[^/]+$')\n  CEL\n  verdict = \"deny\"\n  reason  = \"Repository deletion is not allowed via agent\"\n}\n\nrule \"github-no-force-push\" {\n  endpoint = https.github\n  priority = 1000\n  condition = <<-CEL\n    http.method == 'PATCH'\n    && http.path.matches('^/repos/[^/]+/[^/]+/git/refs/heads/')\n    && http.body.contains('\"force\":true')\n  CEL\n  verdict = \"deny\"\n  reason  = \"Force-push to a default branch is not allowed\"\n}\n\nrule \"github-writes\" {\n  endpoint  = https.github\n  condition = \"http.method in ['POST', 'PATCH', 'PUT', 'DELETE']\"\n  approve   = [human_approver.dashboard-ops]\n  reason    = \"Mutating GitHub calls require human approval\"\n}\n\nrule \"notion-reads\" {\n  endpoint  = https.notion\n  condition = \"http.method in ['GET', 'HEAD']\"\n  verdict   = \"allow\"\n}\nrule \"notion-writes\" {\n  endpoint  = https.notion\n  condition = \"http.method in ['POST', 'PATCH', 'DELETE']\"\n  approve   = [human_approver.dashboard-ops]\n  reason    = \"Notion writes require human approval\"\n}\n\nrule \"k8s-no-secrets\" {\n  endpoints = [kubernetes.k8s-prod-eu, kubernetes.k8s-prod-us]\n  priority  = 1000\n  condition = \"k8s.resource == 'secrets'\"\n  verdict   = \"deny\"\n  reason    = \"Secret values must not leave the cluster via the agent\"\n}\n\nrule \"k8s-no-interactive\" {\n  endpoints = [kubernetes.k8s-prod-eu, kubernetes.k8s-prod-us]\n  priority  = 1000\n  condition = <<-CEL\n    k8s.resource in ['pods/exec', 'pods/attach']\n    && k8s.params.stdin == 'true'\n  CEL\n  verdict = \"deny\"\n  reason  = \"Interactive shells can't be evaluated by the rules engine\"\n}\n\nrule \"k8s-no-disruptive\" {\n  endpoints = [kubernetes.k8s-prod-eu, kubernetes.k8s-prod-us]\n  priority  = 1000\n  condition = \"k8s.verb in ['drain', 'cordon', 'evict']\"\n  verdict   = \"deny\"\n  reason    = \"Cluster-disruptive operations are not allowed\"\n}\n\nrule \"k8s-no-portforward-non-debug\" {\n  endpoints = [kubernetes.k8s-prod-eu, kubernetes.k8s-prod-us]\n  priority  = 1000\n  condition = <<-CEL\n    k8s.resource == 'pods/portforward'\n    && !k8s.name.startsWith('debug-')\n  CEL\n  verdict = \"deny\"\n  reason  = \"Port-forward only allowed to debug-* pods\"\n}\n\nrule \"k8s-no-mutations\" {\n  endpoints = [kubernetes.k8s-prod-eu, kubernetes.k8s-prod-us]\n  condition = <<-CEL\n    k8s.verb in ['create', 'update', 'patch', 'delete']\n    && !k8s.name.startsWith('debug-')\n    && !k8s.resource.endsWith('/exec')\n    && !k8s.resource.endsWith('/attach')\n    && !k8s.resource.endsWith('/portforward')\n  CEL\n  verdict = \"deny\"\n  reason  = \"Only debug-* pods may be created / modified / deleted\"\n}\n\nrule \"k8s-exec-content-check\" {\n  endpoints = [kubernetes.k8s-prod-eu, kubernetes.k8s-prod-us]\n  priority  = 500\n  condition = \"k8s.resource == 'pods/exec'\"\n  approve   = [llm_approver.k8s-exec-content-judge]\n}\n\nrule \"k8s-reads\" {\n  endpoints = [kubernetes.k8s-prod-eu, kubernetes.k8s-prod-us]\n  condition = \"k8s.verb in ['get', 'list', 'watch']\"\n  verdict   = \"allow\"\n}\n\nrule \"k8s-debug-pods\" {\n  endpoints = [kubernetes.k8s-prod-eu, kubernetes.k8s-prod-us]\n  condition = <<-CEL\n    k8s.verb in ['create', 'delete']\n    && k8s.resource == 'pods'\n    && k8s.name.startsWith('debug-')\n  CEL\n  verdict = \"allow\"\n}\n\nrule \"k8s-prod-eu-default\" {\n  endpoint = kubernetes.k8s-prod-eu\n  priority = -100\n  verdict  = \"deny\"\n  reason   = \"Unknown verb \u2014 explicit allow rule required\"\n}\nrule \"k8s-prod-us-default\" {\n  endpoint = kubernetes.k8s-prod-us\n  priority = -100\n  verdict  = \"deny\"\n  reason   = \"Unknown verb \u2014 explicit allow rule required\"\n}\n\nrule \"pg-prod-no-ddl\" {\n  endpoint = postgres.postgres-prod\n  priority = 100\n  condition = <<-CEL\n    sql.verb in [\n      'drop', 'truncate', 'alter', 'grant', 'revoke',\n      'create', 'comment', 'do', 'vacuum',\n    ]\n  CEL\n  verdict = \"deny\"\n  reason  = \"Schema / privilege changes must land via a migration PR\"\n}\n\nrule \"pg-prod-banned-functions\" {\n  endpoint = postgres.postgres-prod\n  priority = 100\n  condition = <<-CEL\n    sets.intersects(sql.functions, ['pg_read_file', 'pg_read_binary_file', 'lo_get'])\n    || sql.functions.exists(f, f.startsWith('dblink_'))\n  CEL\n  verdict = \"deny\"\n  reason  = \"Disallowed function for agent access\"\n}\n\nrule \"pg-prod-banned-copy-from\" {\n  endpoint  = postgres.postgres-prod\n  priority  = 100\n  condition = \"sql.statement.matches('(?is)copy.*from program')\"\n  verdict   = \"deny\"\n  reason    = \"COPY ... FROM PROGRAM is disallowed\"\n}\n\nrule \"pg-prod-banned-copy-to\" {\n  endpoint  = postgres.postgres-prod\n  priority  = 100\n  condition = \"sql.statement.matches('(?is)copy.*to program')\"\n  verdict   = \"deny\"\n  reason    = \"COPY ... TO PROGRAM is disallowed\"\n}\n\nrule \"pg-prod-no-migrations\" {\n  endpoint  = postgres.postgres-prod\n  priority  = 100\n  condition = \"'_sqlx_migrations' in sql.tables\"\n  verdict   = \"deny\"\n  reason    = \"Migrations table is owned by the deploy pipeline\"\n}\n\nrule \"pg-prod-admin-functions\" {\n  endpoint  = postgres.postgres-prod\n  priority  = 100\n  condition = \"sets.intersects(sql.functions, ['pg_terminate_backend', 'pg_cancel_backend'])\"\n  approve   = [human_approver.dashboard-ops]\n  reason    = \"Killing transactions / backends needs a human\"\n}\n\nrule \"pg-prod-secret-columns-check\" {\n  endpoint = postgres.postgres-prod\n  priority = 100\n  condition = <<-CEL\n    sql.verb == 'select'\n    && sets.intersects(sql.tables, [\n      'github_identities',\n      'tokens',\n      'custom_domain_tls_certificates',\n      'oauth_states',\n      'organization_invites',\n      'projects',\n      'deployments',\n      'users',\n    ])\n  CEL\n  approve = [llm_approver.pg-prod-secret-columns-judge]\n}\n\nrule \"pg-prod-mutations\" {\n  endpoint  = postgres.postgres-prod\n  condition = \"sql.verb in ['insert', 'update', 'delete', 'merge', 'notify']\"\n  approve   = [human_approver.dashboard-ops]\n  reason    = \"Postgres mutations require human approval\"\n}\n\nrule \"pg-prod-reads\" {\n  endpoint  = postgres.postgres-prod\n  condition = \"sql.verb in ['select', 'show', 'explain', 'use', 'describe']\"\n  verdict   = \"allow\"\n}\n\nrule \"pg-prod-default\" {\n  endpoint = postgres.postgres-prod\n  priority = -100\n  verdict  = \"deny\"\n  reason   = \"Unknown verb \u2014 explicit allow rule required\"\n}\n\nrule \"clickhouse-prod-reads\" {\n  endpoint  = clickhouse_https.clickhouse-prod\n  condition = \"sql.verb in ['select', 'show', 'describe', 'explain', 'use', 'exists']\"\n  verdict   = \"allow\"\n}\n\nrule \"clickhouse-prod-default\" {\n  endpoint = clickhouse_https.clickhouse-prod\n  priority = -100\n  verdict  = \"deny\"\n  reason   = \"All ClickHouse writes are denied by default; add an explicit rule\"\n}\n\nprofile \"engineering\" {\n  credentials = [\n    anthropic_oauth_subscription.anthropic-engineering-bot,\n    openai_codex_oauth.codex-engineering-bot,\n    github_oauth.github-engineering-bot,\n  ]\n}\n\nprofile \"mac-claude\" {\n  credentials = [\n    anthropic_oauth_subscription.anthropic-macbook,\n    mtls_credential.k8s-prod-eu-mtls,\n  ]\n}\n\nprofile \"oncall\" {\n  credentials = [\n    github_oauth.github-pagerdutybot,\n    notion_oauth.notion-pagerdutybot,\n    postgres_credential.postgres-cred,\n    mtls_credential.k8s-prod-us-mtls,\n    clickhouse_credential.clickhouse-cred,\n  ]\n}\n\nprofile \"default\" {\n  credentials = [\n    anthropic_oauth_subscription.anthropic-engineering-bot,\n    github_oauth.github-engineering-bot,\n  ]\n}\n"
